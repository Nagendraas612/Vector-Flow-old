generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum FeeType {
  FREE
  PAID
}

enum RegistrationMode {
  SITE
  EXTERNAL
}

enum EventStatus {
  DRAFT
  PUBLISHED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum Attendance {
  UNMARKED
  PRESENT
  ABSENT
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
}

enum CertificateStatus {
  UPLOADED
  HELD
  QUEUED
  SENT
  FAILED
}

enum MailType {
  ANNOUNCEMENT
  REGISTRATION
  PAYMENT_VERIFIED
  PAYMENT_REJECTED
  REMINDER_24H
  CERTIFICATE
}

enum MailStatus {
  QUEUED
  SENT
  FAILED
}

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  usn         String?  @unique
  branch      String?
  semester    Int?
  phone       String?
  role        Role     @default(STUDENT)
  createdAt   DateTime @default(now()) @map("created_at")
  lastLoginAt DateTime? @map("last_login_at")
  eventsCreated Event[] @relation("CreatedBy")
  registrations Registration[]
  certificates  Certificate[]
  @@map("users")
}

model Event {
  id                      String   @id @default(uuid())
  title                   String
  slug                    String   @unique
  description             String
  posterImageUrl          String?  @map("poster_image_url")
  venue                   String?
  mode                    String
  startAt                 DateTime @map("start_at")
  endAt                   DateTime? @map("end_at")
  registrationOpensAt     DateTime? @map("registration_opens_at")
  registrationClosesAt    DateTime? @map("registration_closes_at")
  feeType                 FeeType  @map("fee_type")
  feeAmount               Int?     @map("fee_amount")
  paymentReceiverName     String?  @map("payment_receiver_name")
  paymentReceiverContact  String?  @map("payment_receiver_contact")
  paymentQrImageUrl       String?  @map("payment_qr_image_url")
  registrationMode        RegistrationMode @default(SITE) @map("registration_mode")
  externalRegistrationUrl String?  @map("external_registration_url")
  driveLink               String?  @map("drive_link")
  status                  EventStatus @default(DRAFT)
  announcementSentAt      DateTime? @map("announcement_sent_at")
  createdById             String   @map("created_by")
  createdBy               User     @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  registrations           Registration[]
  certificates            Certificate[]
  mailLogs                MailLog[]
  teamLinks               GalleryItem[]
  @@map("events")
}

model Registration {
  id                   String   @id @default(uuid())
  eventId              String   @map("event_id")
  event                Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId               String   @map("user_id")
  user                 User     @relation(fields: [userId], references: [id])
  name                 String
  usn                  String
  email                String
  branch               String?
  semester             Int?
  phone                String?
  paymentStatus        PaymentStatus @default(NOT_REQUIRED) @map("payment_status")
  rejectionReason      String?  @map("rejection_reason")
  paymentScreenshotUrl String?  @map("payment_screenshot_url")
  attendance           Attendance @default(UNMARKED)
  status               RegistrationStatus @default(REGISTERED)
  reminderSentAt       DateTime? @map("reminder_sent_at")
  registeredAt         DateTime @default(now()) @map("registered_at")
  cancelledAt          DateTime? @map("cancelled_at")
  certificate          Certificate?
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@map("registrations")
}

model Certificate {
  id             String   @id @default(uuid())
  eventId        String   @map("event_id")
  event          Event    @relation(fields: [eventId], references: [id])
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  registrationId String   @unique @map("registration_id")
  registration   Registration @relation(fields: [registrationId], references: [id])
  fileUrl        String   @map("file_url")
  fileName       String?  @map("file_name")
  status         CertificateStatus @default(UPLOADED)
  sendTicked     Boolean  @default(false) @map("send_ticked")
  issuedAt       DateTime? @map("issued_at")
  emailedAt      DateTime? @map("emailed_at")
  mailError      String?  @map("mail_error")
  uploadedById   String   @map("uploaded_by")
  @@map("certificates")
}

model MailLog {
  id            String   @id @default(uuid())
  eventId       String?  @map("event_id")
  event         Event?   @relation(fields: [eventId], references: [id])
  userId        String?  @map("user_id")
  certificateId String?  @map("certificate_id")
  toEmail       String   @map("to_email")
  type          MailType
  subject       String?
  status        MailStatus @default(QUEUED)
  error         String?
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime @default(now()) @map("created_at")
  @@index([status])
  @@map("mail_logs")
}

model TeamMember {
  id            String   @id @default(uuid())
  name          String
  designation   String
  photoUrl      String?  @map("photo_url")
  bio           String?
  orderIndex    Int      @default(0) @map("order_index")
  academicYear  String   @map("academic_year")
  isCurrentYear Boolean  @default(false) @map("is_current_year")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  @@index([academicYear, orderIndex])
  @@map("team_members")
}

model GalleryItem {
  id            String   @id @default(uuid())
  eventId       String   @map("event_id")
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title         String?
  driveLink     String   @map("drive_link")
  coverImageUrl String?  @map("cover_image_url")
  type          String
  createdAt     DateTime @default(now()) @map("created_at")
  @@map("gallery_items")
}
